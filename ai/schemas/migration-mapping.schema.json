{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MigrationMapping",
  "description": "Proposed mapping of one legacy (1C/BAF export) column onto a target field. Reviewed by a human before the deterministic import (Tier 3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "target", "transform", "confidence", "rationale", "needs_review"],
  "properties": {
    "source": {"type": "string", "maxLength": 120},
    "target": {"type": "string", "enum": ["name", "phone", "tax_id", "kind", "skip"]},
    "transform": {"type": "string", "maxLength": 80},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "maxLength": 200},
    "needs_review": {"type": "boolean"}
  }
}
