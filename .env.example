# Copy to .env and change everything before exposing the app beyond localhost.
STO_ENV=demo                  # production → refuses DEMO_MODE and demands STO_SECRET
STO_SECRET=                   # python -c "import secrets;print(secrets.token_urlsafe(32))"
DEMO_MODE=1                   # synthetic data + demo accounts; must be 0 in production
COOKIE_SECURE=0               # 1 behind HTTPS (always in production)
STO_LOCALE=en                 # en | uk — default UI language
STO_PORT=8000

POSTGRES_PASSWORD=change-me-owner
STO_APP_DB_PASSWORD=change-me-app

# optional language model (OpenAI-compatible); "stub" = offline rule-based extractor
LLM_PROVIDER=stub
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5

# optional Telegram bot (docker compose --profile bot up)
TG_BOT_TOKEN=
STO_API_TOKEN=                # create in Settings → API tokens (type: Telegram bot)
